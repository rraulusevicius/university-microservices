# Copy to .env and fill in. Used by docker-compose and by k8s/deploy.ps1 (as a Kubernetes Secret).
# .env is gitignored — never commit real values.

# SQL Server "sa" password — must meet SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
# Avoid ; and $ (they break the connection string / compose interpolation).
SA_PASSWORD=Change-Me-123

# RabbitMQ credentials — used inside an amqp:// URI, so avoid @ : / in them.
RABBITMQ_USER=university
RABBITMQ_PASS=change-me

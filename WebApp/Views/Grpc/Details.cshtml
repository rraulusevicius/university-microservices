@model StudentsAPI.Protos.StudentReply

<h2>@Model.FirstMidName @Model.LastName</h2>
<p>Enrolled: @Model.EnrollmentDate</p>
<span class="badge bg-success">Loaded via gRPC</span>

<h4 class="mt-3">Enrollments</h4>
@if (Model.Enrollments.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Course</th>
                <th>Credits</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Enrollments)
            {
                <tr>
                    <td>@e.Title</td>
                    <td>@e.Credits</td>
                    <td>@(e.HasGrade ? ((WebApp.Models.Grade)e.Grade).ToString() : "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No enrollments found.</p>
}
<a asp-action="Students" class="btn btn-secondary">Back to List</a>
@model List<WebApp.Models.Student>

<h2>Students</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Last Name</th>
            <th>First Name</th>
            <th>Enrollment Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.ID</td>
                <td>@s.LastName</td>
                <td>@s.FirstMidName</td>
                <td>@s.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                <td><a asp-action="Details" asp-route-id="@s.ID" class="btn btn-sm btn-primary">Details</a></td>
            </tr>
        }
    </tbody>
</table>